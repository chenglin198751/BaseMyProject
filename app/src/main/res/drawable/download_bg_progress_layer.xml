<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 背景层 -->
    <item>
        <shape>
            <solid android:color="#00CED1" />
        </shape>
    </item>

    <!-- 进度层（关键） -->
    <item>
        <clip
            android:clipOrientation="horizontal"
            android:gravity="left">
            <shape>
                <solid android:color="#2979FF" />
            </shape>
        </clip>
    </item>

</layer-list>
